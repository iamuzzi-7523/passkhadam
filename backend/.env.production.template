# ==============================================================================
# PASSKHADAM - Staging & Production Cloud Environment Configuration Template
# ==============================================================================
# Configure these variables in your Render Web Service Environment Dashboard.
# NEVER commit production secrets or private keys to source control.

# --- Environment & App Core ---
ENVIRONMENT=production
PROJECT_NAME=PASSKHADAM
VERSION=0.2.0
SECRET_KEY=generate-a-64-character-random-hex-string-for-jwt-signing
PUBLIC_APP_BASE_URL=https://passkhadam.vercel.app

# --- Render Deployment Health Check & Ports ---
# Render automatically sets PORT. Health Check Path in Render Settings: /health

# --- Authoritative PostgreSQL Database (Supabase) ---
# Replace with your Supabase Transaction Pooler URI (port 6543) or Direct URI (port 5432)
DATABASE_URL=postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Strict Production CORS Origins ---
# Comma-separated list of approved web and desktop origins
ALLOWED_ORIGINS=https://passkhadam.vercel.app,app://passkhadam.app

# --- Decentralized Storage (Pinata IPFS Gateway) ---
IPFS_PROVIDER=pinata
PINATA_JWT=your_pinata_jwt_bearer_token_here
# Optional legacy key pair (if not using JWT):
# PINATA_API_KEY=your_pinata_api_key
# PINATA_SECRET_KEY=your_pinata_secret_key

# --- EVM Blockchain (Ethereum Sepolia Testnet via Alchemy / Infura) ---
WEB3_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
CHAIN_ID=11155111

# --- Email & OTP Delivery (Resend HTTPS REST / SMTP) ---
RESEND_API_KEY=re_your_resend_api_key_here
EMAILS_FROM_EMAIL=notifications@your-verified-domain.com

# --- Optional Outgoing SMTP (if using custom SMTP provider instead of Resend) ---
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_your_resend_api_key_here
